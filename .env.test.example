# Only for docker-compose.test.yml on the test server. Copy to .env there.
COMPOSE_PROJECT_NAME=smartdiet-test
TEST_APP_PORT=8000
TEST_MINIO_PORT=9002
TEST_MINIO_CONSOLE_PORT=9001

# API and MinIO ports bind to loopback. Configure your own reverse proxy.
# Trust only the proxy's actual peer IP/CIDR as observed by the API container.
# Leave empty until the proxy is configured; never use * on an exposed backend.
FORWARDED_ALLOW_IPS=

# Public package index used only during image builds; keep HTTPS enabled.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TIMEOUT=60
PIP_RETRIES=5

# Required: generate a separate random value for each password/secret.
# POSTGRES_PASSWORD must be URL-safe because it is part of DATABASE_URL.
# Example: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ROOT_USER=smartdiet
MINIO_ROOT_PASSWORD=

# Required S3 API root URL reachable by clients, with no path prefix.
# Configure this address in your own proxy before clients access images.
MINIO_PUBLIC_URL=https://images.hsunr.xyz
MINIO_BUCKET=smartdiet
MINIO_REGION=us-east-1
IMAGE_URL_EXPIRE_SECONDS=900

# Optional integrations: leave WeChat credentials empty if unused.
WECHAT_APPID=
WECHAT_SECRET=
ALLOW_MOCK_LOGIN=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_VISION_MODEL=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREFIX=smartdiet:test:ratelimit:v1
