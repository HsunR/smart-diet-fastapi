DATABASE_URL=postgresql+asyncpg://smartdiet:smartdiet@localhost:5432/smartdiet
WECHAT_APPID=wx-your-appid       # 微信小程序 AppID，缺失时拒绝微信登录
WECHAT_SECRET=your-secret         # 微信小程序 Secret，缺失时拒绝微信登录
ALLOW_MOCK_LOGIN=false            # 仅本地/H5 调试可设为 true，生产必须保持 false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-key
LLM_VISION_MODEL=  # optional, defaults to LLM_MODEL if empty
JWT_SECRET=change-me-in-production

# MinIO object storage. MINIO_PUBLIC_URL must be reachable by clients and the vision LLM.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=smartdiet
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
