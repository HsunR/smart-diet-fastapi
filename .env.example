DATABASE_URL=postgresql+asyncpg://smartdiet:smartdiet@localhost:5432/smartdiet  # 数据库连接串，必须使用 asyncpg 异步驱动
WECHAT_APPID=wx-your-appid       # 微信小程序 AppID，缺失时拒绝微信登录
WECHAT_SECRET=your-secret         # 微信小程序 Secret，缺失时拒绝微信登录
ALLOW_MOCK_LOGIN=false            # 仅本地/H5 调试可设为 true，生产必须保持 false
LLM_BASE_URL=https://api.openai.com/v1  # 大模型接口地址，兼容 OpenAI 协议的 /v1 根路径
LLM_MODEL=gpt-4o                  # 默认文本模型，用于生成饮食建议
LLM_API_KEY=sk-your-key           # 大模型接口密钥，留空则识别功能不可用
# 识图模型名称，留空时默认复用 LLM_MODEL
LLM_VISION_MODEL=
JWT_SECRET=change-me-in-production  # JWT 签名密钥，生产环境必须替换为随机长字符串

# 私有 MinIO 存储。MINIO_PUBLIC_URL 为客户端可访问的 S3 API 根地址（不带路径）。
MINIO_ENDPOINT=localhost:9000     # MinIO 服务地址，供后端内网访问
MINIO_ACCESS_KEY=minioadmin       # MinIO 访问密钥
MINIO_SECRET_KEY=minioadmin       # MinIO 私密密钥
MINIO_BUCKET=smartdiet            # 存放照片的桶名，服务启动时自动创建
MINIO_SECURE=false                # 后端连接 MinIO 是否走 HTTPS
MINIO_PUBLIC_URL=http://localhost:9000  # 客户端可访问的 S3 API 根地址，不带路径
MINIO_REGION=us-east-1            # 对象存储签名区域，MinIO 默认值即可
IMAGE_URL_EXPIRE_SECONDS=900      # 图片预签名链接有效期（秒），允许范围 60-3600

# Redis：Compose 内用 redis 主机；本地 Python 连接时需自行启动可访问的 Redis。
# Compose 不向宿主机发布 Redis 端口。必须设置随机密码（例如 secrets.token_urlsafe(32)）。
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=smartdiet

# Redis 滑动窗口；已放行的尝试均计数，超限拒绝不重复扣配额。
LOGIN_IP_PER_MINUTE=20            # 单 IP 每分钟最多登录请求次数
LOGIN_ACCOUNT_PER_15_MINUTES=10   # 单账号每 15 分钟最多登录尝试次数
REGISTER_IP_PER_HOUR=5            # 单 IP 每小时最多注册请求次数
UPLOAD_IP_PER_MINUTE=60           # 单 IP 每分钟最多图片上传请求次数
UPLOAD_USER_IMAGES_PER_DAY=200    # 单用户每天最多上传图片张数
RECOGNITION_IP_PER_MINUTE=30      # 单 IP 每分钟最多识别请求次数
RECOGNITION_USER_PER_MINUTE=6     # 单用户每分钟最多识别请求次数
RECOGNITION_USER_PER_DAY=100      # 单用户每天最多识别请求次数
RECOGNITION_GLOBAL_CONCURRENCY=8  # 全局同时执行的识别任务上限（1-100）
RECOGNITION_USER_CONCURRENCY=1    # 单用户同时执行的识别任务上限（1-10）
